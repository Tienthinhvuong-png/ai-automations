# Khóa Claude API, lấy tại https://platform.claude.com
ANTHROPIC_API_KEY=

# Tùy chọn
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
BRAND_NAME=Tên cửa hàng của anh
BRAND_VOICE=thân thiện, gần gũi, xưng 'mình' và gọi khách là 'bạn'

# Gửi bản nháp qua Telegram để duyệt (để trống nếu chưa dùng)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

OUTPUT_DIR=output
